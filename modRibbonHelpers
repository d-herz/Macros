Option Explicit
' This module is for navigation macros placed in the Ribbon

' Public variables for SheetPicker form cancellation
Public g_PreviousSheet As Worksheet
Public g_DidNavigate As Boolean


' Public variables for the two-state sheet toggle (back button)
Public g_LastSheet As Worksheet
Public g_CurrentSheet As Worksheet
'--------------------------------------------------------------
' Ribbon Navigation Macros
Sub GoToDash(control As IRibbonControl)
    On Error Resume Next
    Worksheets("Dash").Activate
    If Err.Number <> 0 Then
        MsgBox "Dash sheet not found!", vbExclamation
    End If
    On Error GoTo 0
End Sub


Sub GoToProjectInfo(control As IRibbonControl)
    On Error Resume Next
    Worksheets("ProjectInfo").Activate
     Worksheets("ProjectInfo").Range("D6").Select
    If Err.Number <> 0 Then MsgBox "ProjectInfo sheet not found!", vbExclamation
    On Error GoTo 0
End Sub

Sub GoToSummaryCDM(control As IRibbonControl)
