    If Err.Number <> 0 Then MsgBox "ItemList sheet not found!", vbExclamation
    On Error GoTo 0
End Sub

'---------------------------------------------------------------------
' --------------------------------------------------------------------
' Two-state sheet toggle ("Back" button, essentially)
Public Sub GoBackToPreviousSheet(control As IRibbonControl)

    Dim temp As Worksheet

    If g_PreviousSheet Is Nothing Or g_CurrentSheet Is Nothing Then Exit Sub

    Application.EnableEvents = False

    Set temp = g_CurrentSheet
    Set g_CurrentSheet = g_PreviousSheet
    Set g_PreviousSheet = temp

    g_CurrentSheet.Activate

    Application.EnableEvents = True

End Sub

Public Function GetBackButtonEnabled(control As IRibbonControl) As Boolean
    GetBackButtonEnabled = Not g_PreviousSheet Is Nothing
End Function


'-----------------------------------------------------------------------------------
'------------------------------------------------------------------------------------
' Helpers for the Sheetpicker User Form

Function ComboContains(cbo As Object, value As String) As Boolean
    Dim i As Long
    For i = 0 To cbo.ListCount - 1
        If StrComp(cbo.List(i), value, vbTextCompare) = 0 Then
            ComboContains = True
            Exit Function
        End If
    Next i
    ComboContains = False
End Function
Sub ShowSheetPicker()

    Set g_PreviousSheet = ActiveSheet
    g_DidNavigate = False

    SheetPickerForm.Show

    ' If user cancelled (Esc / X), restore sheet
    If Not g_DidNavigate Then
        If Not g_PreviousSheet Is Nothing Then
            g_PreviousSheet.Activate
        End If
    End If

End Sub
